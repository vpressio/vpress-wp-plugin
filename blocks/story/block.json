{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vpress/story",
	"title": "Vpress story",
	"category": "embed",
	"icon": "book",
	"description": "One chart that stays put while the reader scrolls through steps that change what it emphasises.",
	"keywords": [ "story", "historia", "scrollytelling", "vpress", "chart", "data" ],
	"textdomain": "vpress",
	"attributes": {
		"chartId": {
			"type": "integer"
		},
		"showCaption": {
			"type": "boolean",
			"default": true
		}
	},
	"providesContext": {
		"vpress/chartId": "chartId"
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}
